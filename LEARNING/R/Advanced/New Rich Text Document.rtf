\par \pard\plain \s3\sb240\sa120\keepn\dbch\af8\dbch\af10\afs28\loch\f4\fs28{\rtlch \ltrch\loch
Examples}
\par \pard\plain \s26{\rtlch \ltrch\loch
require(stats) # for lowess, rpois, rnorm}
\par \pard\plain \s26{\rtlch \ltrch\loch
plot(cars)}
\par \pard\plain \s26{\rtlch \ltrch\loch
lines(lowess(cars))}
\par \pard\plain \s26\rtlch \ltrch\loch

\par \pard\plain \s26{\rtlch \ltrch\loch
plot(sin, -pi, 2*pi) # see ?plot.function}
\par \pard\plain \s26\rtlch \ltrch\loch

\par \pard\plain \s26{\rtlch \ltrch\loch
## Discrete Distribution Plot:}
\par \pard\plain \s26{\rtlch \ltrch\loch
plot(table(rpois(100, 5)), type = "h", col = "red", lwd = 10,}
\par \pard\plain \s26{\rtlch \ltrch
     }{\rtlch \ltrch\loch
main = "rpois(100, lambda = 5)")}
\par \pard\plain \s26\rtlch \ltrch\loch

\par \pard\plain \s26{\rtlch \ltrch\loch
## Simple quantiles/ECDF, see ecdf() \{library(stats)\} for a better one:}
\par \pard\plain \s26{\rtlch \ltrch\loch
plot(x <- sort(rnorm(47)), type = "s", main = "plot(x, type = \\"s\\")")}
\par \pard\plain \s26\sb0\sa283{\rtlch \ltrch\loch
points(x, cex = .5, col = "dark red")}
\par \pard\plain \s29\rtlch \ltrch\loch

