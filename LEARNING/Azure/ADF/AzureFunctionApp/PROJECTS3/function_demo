LN_API_content = """<?xml version=\"1.0\" ?><S:Envelope xmlns:S=\"http://schemas.xmlsoap.org/soap/envelope/\"><S:Body><CreateResponse xmlns=\"http://www.infor.com/businessinterface/RegionWiseDFU\"><CreateRequest xmlns=\"\"><DataArea><GetDFUResponse><Region>India</Region><Item>         X100179                               </Item><Verticals>ACP-AFM-Industrial</Verticals><DFU>                                                                                                    </DFU><ItemCatg>Units</ItemCatg><RRSClassification>Runner</RRSClassification><Classification>  </Classification><Revenue>0</Revenue><Priority>0</Priority><Updateddate>09-01-1970</Updateddate></GetDFUResponse></DataArea></CreateRequest></CreateResponse></S:Body></S:Envelope>"""


# Decode HTML entities
xml_string = html.unescape(LN_API_content)
root = ET.fromstring(xml_string)

# Find GetDFUResponse ignoring namespaces
for elem in root.iter():
    if elem.tag.endswith("GetDFUResponse"):
        get_dfu = elem
        break

result = {
child.tag.split("}")[-1]: child.text.strip() if child.text else ""
for child in get_dfu
}

print(result)




# Extract data
# Find GetDFUResponse
responses = root.findall(".//GetDFUResponse")

print("Number of GetDFUResponse records:", len(responses))


for record in responses:

    print("\n========== RECORD ==========")

    region = record.findtext("Region", default="").strip()
    item = record.findtext("Item", default="").strip()
    verticals = record.findtext("Verticals", default="").strip()
    dfu = record.findtext("DFU", default="").strip()
    item_catg = record.findtext("ItemCatg", default="").strip()
    rrs_classification = record.findtext(
        "RRSClassification",
        default=""
    ).strip()

    classification = record.findtext(
        "Classification",
        default=""
    ).strip()

    revenue = record.findtext(
        "Revenue",
        default=""
    ).strip()

    priority = record.findtext(
        "Priority",
        default=""
    ).strip()

    updated_date = record.findtext(
        "Updateddate",
        default=""
    ).strip()


    print("Region:", region)
    print("Item:", item)
    print("Verticals:", verticals)
    print("DFU:", dfu)
    print("ItemCatg:", item_catg)
    print("RRSClassification:", rrs_classification)
    print("Classification:", classification)
    print("Revenue:", revenue)
    print("Priority:", priority)
    print("Updateddate:", updated_date)




